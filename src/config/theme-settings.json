{
    "groups": [
        {
            "name": "Blog",
            "fields": [
                {
                    "name": "blogMainPageBannerHeading",
                    "label": "Banner heading",
                    "type": "text",
                    "defaultValue": "Blog"
                },
                {
                    "name": "blogMainPageBannerImage",
                    "label": "Banner Image",
                    "type": "image",
                    "description": "The image will be cropped on the page to match the Banner Bar settings. See Styles - Blocks Banner Bar - Banner Bar Images for more information.",
                    "path": "images/banner",
                    "maxWidth": "2000",
                    "useAttributes": false
                }
            ]
        },
        {
            "name": "Breadcrumb",
            "fields": [
                {
                    "name": "showBreadcrumb",
                    "label": "Show Breadcrumb Text",
                    "type": "switch",
                    "defaultValue": "yes"
                }
            ]
        },
        {
            "name": "Customer Reviews & Ratings",
            "description": "Settings for the ratings",
            "fields": [
                {
                    "name": "customerRatingsBarReviewsLink",
                    "label": "URL to view reviews",
                    "type": "url",
                    "showLinkTextField": true
                },
                {
                    "name": "customerRatingsBarTotalReviews",
                    "label": "Total number of reviews",
                    "type": "text"
                },
                {
                    "name": "customerRatingsBarAverageRating",
                    "label": "Average rating",
                    "type": "text"
                }
            ]
        },
        {
            "name": "Footer",
            "description": "Content for the footer that is used on all pages",
            "fields": [
                {
                    "name": "footerLogo",
                    "label": "Logo",
                    "type": "image",
                    "path": "images",
                    "preview": {
                        "type": "replace",
                        "contentSelector": ".Footer-logo",
                        "template": "<img src=\"{{ url }}\" height=\"{{ imageHeight }}\" width=\"{{ imageWidth }}\" alt=\"{{ alt }}\" class=\"Footer-logo\">"
                    }
                },
                {
                    "name": "footerLogoWidth",
                    "label": "Logo width",
                    "type": "stepper",
                    "after": "px",
                    "defaultValue": "425",
                    "preview": {
                        "type": "css-head",
                        "cssVariable": "--Footer-logo-width",
                        "template": "{{ value }}px"
                    }
                }
            ]
        },
        {
            "name": "Header",
            "description": "Content for the header that is used on all pages",
            "fields": [
                {
                    "name": "headerLogo",
                    "label": "Logo",
                    "type": "image",
                    "path": "images",
                    "preview": {
                        "type": "replace",
                        "contentSelector": ".Header-logo",
                        "template": "<img src=\"{{ url }}\" height=\"{{ imageHeight }}\" width=\"{{ imageWidth }}\" alt=\"{{ alt }}\" class=\"Header-logo\">"
                    }
                },
                {
                    "name": "headerLogoWidth",
                    "label": "Logo width",
                    "type": "stepper",
                    "after": "px",
                    "defaultValue": "425",
                    "preview": {
                        "type": "css-head",
                        "cssVariable": "--Header-logo-width",
                        "template": "{{ value }}px"
                    }
                },
                {
                    "name": "headerTextLogo",
                    "label": "Text logo",
                    "type": "text",
                    "description": "Shown instead of the logo image when no image is uploaded.",
                    "preview": {
                        "type": "replace",
                        "contentSelector": "#header-logo",
                        "template": "<div class=\"col-3-4 col-1-3-xl\" id=\"header-logo\">{% if fields.headerLogo %}<a href=\"/\" title=\"return to home page\" class=\"Header-logoLink\"><img src=\"{{ fields.headerLogo.url }}\" class=\"Header-logo\"></a>{% elseif value %}<a href=\"/\" title=\"return to home page\" class=\"Header-logoLink\"><span class=\"Header-textLogo\">{{ value }}</span></a>{% endif %}</div>"
                    }
                }
            ]
        },
        {
            "name": "Social Icons",
            "description": "Set the links and icons to use for your social networks in the footer of each page.",
            "sidebarSize": "medium",
            "fields": [
                {
                    "name": "social",
                    "label": "Social Networks",
                    "type": "repeatingGrid",
                    "itemName": "Social Network",
                    "children": [
                        {
                            "name": "icon",
                            "label": "Icon",
                            "type": "select",
                            "options": {
                                "facebook": "Facebook",
                                "google": "Google",
                                "instagram": "Instagram",
                                "linkedin": "LinkedIn",
                                "pinterest": "Pinterest",
                                "tiktok": "TikTok",
                                "whatsapp": "WhatsApp",
                                "x": "X (Twitter)",
                                "youtube": "YouTube"
                            },
                            "columnWidth": "1fr"
                        },
                        {
                            "name": "url",
                            "label": "URL to your page on this social network",
                            "type": "text",
                            "columnWidth": "2fr"
                        }
                    ]
                }
            ]
        }
    ]
}
